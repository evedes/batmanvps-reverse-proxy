#!/bin/sh
set -eu
base=/home/edo/.config/getkinfolio-staging/acme
certbot renew --config-dir "$base/config" --work-dir "$base/work" --logs-dir "$base/log" --quiet
cert="$base/config/live/staging.getkinfolio.com"
dest=/home/edo/ssl/getkinfolio/staging
if ! cmp -s "$cert/fullchain.pem" "$dest/fullchain.pem"; then
  install -m 644 "$cert/fullchain.pem" "$dest/fullchain.pem"
  install -m 600 "$cert/privkey.pem" "$dest/privkey.pem"
  docker exec nginx-reverseproxy nginx -t
  docker exec nginx-reverseproxy nginx -s reload
fi
